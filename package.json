{
  "name": "vision-mcp-server",
  "version": "1.1.1",
  "description": "Reliable vision MCP server with ordered fallback across ModelScope, Zhipu, and OpenAI-compatible models",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "files": [
    "dist",
    "!dist/index-new.*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "npm run build && node scripts/live-smoke-test.mjs",
    "test:live:env": "npm run build && node --env-file=.env.local scripts/live-smoke-test.mjs"
  },
  "keywords": [
    "mcp",
    "vision",
    "modelscope",
    "zhipu",
    "openai-compatible",
    "fallback",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Markusbetter/vision-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/Markusbetter/vision-mcp-server/issues"
  },
  "homepage": "https://github.com/Markusbetter/vision-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openai": "^4.104.0",
    "sharp": "^0.35.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "bin": {
    "vision-mcp-server": "dist/index.js"
  },
  "overrides": {
    "form-data": "^4.0.6"
  }
}
